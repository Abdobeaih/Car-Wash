# ─────────────────────────────────────────────────────────────
# Mobile Car Care — Environment Variables
# Copy this file to `.env` and fill in your own values.
# NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Backend (apps/api/.env)
PORT=3001
DATABASE_URL=mongodb://127.0.0.1:27017/mobile-car-care
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# Backend CORS — comma separated allowed origins
CORS_ORIGINS=http://localhost:3000

# Frontend (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Seed credentials (development only)
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_CUSTOMER_NAME=Demo Customer
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=CustomerPass123!