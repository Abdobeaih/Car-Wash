# Frontend environment — copy to .env.local
# Local development: point at the local NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Vercel deployment (set in Vercel project env vars, NOT in this file):
# API_URL=<your deployed API URL, e.g. https://car-wash-api.vercel.app>
# The browser talks to the same origin via /api/* (Next.js rewrites), so no
# NEXT_PUBLIC_API_URL is required in production.