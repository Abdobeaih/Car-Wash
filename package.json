{
  "name": "mobile-car-care",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile Car Care — book professional mobile car care services online",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run start:dev --workspace=api",
    "build": "npm run build --workspaces",
